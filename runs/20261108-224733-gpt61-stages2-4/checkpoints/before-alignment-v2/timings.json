        {
          "sentence_id": "scene_003.n1.s1",
          "scene_id": "scene_003",
          "narration_index": 0,
          "text": "AI answers are probabilistic: repeating the same question can produce different brands.",
          "char_start": 0,
          "char_end": 87,
          "claim_ids": [
            "claim_005"
          ],
          "word_start": 101,
          "word_end": 113,
          "score": 1.0,
