          "method": "even_fallback"
        },
        {
          "sentence_id": "scene_003.n2.s1",
          "scene_id": "scene_003",
          "narration_index": 1,
          "text": "Track a fixed set of real buyer questions daily across the AI platforms your buyers use, then read the trend.",
