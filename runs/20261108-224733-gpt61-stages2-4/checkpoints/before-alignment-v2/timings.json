          "sentence_id": "scene_002.n1.s1",
          "scene_id": "scene_002",
          "narration_index": 0,
          "text": "Start by defining success: leads, sign-ups, or revenue from AI referrals, rather than citation counts or visibility scores.",
          "char_start": 0,
          "char_end": 123,
          "claim_ids": [
            "claim_003"
