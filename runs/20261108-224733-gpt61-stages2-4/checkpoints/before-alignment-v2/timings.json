        {
          "sentence_id": "scene_004.n1.s1",
          "scene_id": "scene_004",
          "narration_index": 0,
          "text": "In Searchbloom's own tracking, about nine of every ten sources AI cites are on other people's sites.",
          "char_start": 0,
          "char_end": 100,
