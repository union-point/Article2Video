          "method": "even_fallback"
        },
        {
          "sentence_id": "scene_002.n3.s1",
          "scene_id": "scene_002",
          "narration_index": 2,
          "text": "Watch for promises of AI citations in weeks, or reports that count citations without mentioning leads or revenue.",
